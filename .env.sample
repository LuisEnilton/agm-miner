# GitHub
GITHUB_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# App
APP_NAME=agm-miner
LOG_LEVEL=INFO
ENVIRONMENT=development

# Postgres
DATABASE_URL=postgresql+psycopg2://research_user:research_password@localhost:5432/agent_artifacts_research
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=research_user
POSTGRES_PASSWORD=research_password
POSTGRES_DB=agent_artifacts_research

# Storage
RAW_DATA_DIR=data/raw
GOLD_DATA_DIR=data/gold

# Rate limiting
CORE_RATE_LIMIT_MIN_REMAINING=50
SEARCH_RATE_LIMIT_MIN_REMAINING=2
RATE_LIMIT_SLEEP_BUFFER_SECONDS=5
