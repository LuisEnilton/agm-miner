# GitHub token (read-only public access is enough). Needed by `agm discover`, `agm select`
# and `agm add-repo`; mining clones public repositories over HTTPS without it.
GITHUB_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# LLM keys for the RQ1 content coding (agm rq1 ...), used according to rq1.provider in study.yaml.
# Claude (final collection); optional if you ran `ant auth login`.
ANTHROPIC_API_KEY=
# Gemini API (testing with the free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (alternative for testing with free models): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Secret that pseudonymises names and e-mails in the replication package (agm package): at least
# 16 characters. Keep it to rebuild the same pseudonyms; never publish it.
PACKAGE_SALT=

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://research_user:research_password@localhost:5432/agent_artifacts_research

LOG_LEVEL=INFO

# Storage: bronze exports go to DATA_DIR/bronze, analysis datasets to DATA_DIR/gold
DATA_DIR=data
CLONE_DIR=data/clones

# Methodological parameters of the study (versioned; a snapshot is stored with every run)
STUDY_CONFIG_PATH=study.yaml

# GitHub API pacing
SEARCH_RATE_LIMIT_MIN_REMAINING=2
GRAPHQL_RATE_LIMIT_MIN_REMAINING=100
RATE_LIMIT_SLEEP_BUFFER_SECONDS=5
GITHUB_MAX_RETRIES=5

# Wall-clock limit for each git command (large repositories)
GIT_TIMEOUT_SECONDS=1800

# Progress display: auto (live panel in a terminal, summary log lines otherwise), live, plain, off
AGM_PROGRESS=auto

# Test suite database (created and reset automatically by the tests). Read from this file when
# not set in the environment; give each git worktree its own, so suites can run in parallel.
TEST_DATABASE_URL=postgresql+psycopg2://research_user:research_password@localhost:5432/agm_test
